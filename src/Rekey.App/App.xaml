<Application x:Class="Rekey.App.App"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="Rekey">
      <tb:TaskbarIcon.IconSource>
        <!-- H.NotifyIcon 2.4.1 draws the text from the top-left corner of TextMargin and drops a
             line taller than that area, so this margin centers the letter by hand. -->
        <tb:GeneratedIconSource Text="R"
                                Foreground="White"
                                Background="#2D6CDF"
                                FontSize="80"
                                FontWeight="Bold"
                                Size="128"
                                TextMargin="24,-15,0,-24"
                                BackgroundType="RoundedRectangle"
                                CornerRadius="24" />
      </tb:TaskbarIcon.IconSource>
      <tb:TaskbarIcon.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Quit" Click="OnQuitClick" />
        </ContextMenu>
      </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
  </Application.Resources>
</Application>
