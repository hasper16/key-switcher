#!/bin/sh
# commit-msg: enforce Conventional Commits 1.0.0
# https://www.conventionalcommits.org/en/v1.0.0/#specification
# Project choices on top of the spec: lowercase type and scope, header <= 100 chars.

msg_file="$1"
fail() { echo "commit-msg: $1" >&2; echo "Format: <type>[(scope)][!]: <description>   e.g. feat(core): add deferred word run" >&2; exit 1; }

# Ignore comment lines git adds in the editor.
msg=$(grep -v '^#' "$msg_file")
header=$(printf '%s\n' "$msg" | sed -n '1p')
line2=$(printf '%s\n' "$msg" | sed -n '2p')

# Messages git generates itself.
case "$header" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

types='feat|fix|build|chore|ci|docs|style|refactor|perf|test|revert'
printf '%s' "$header" | grep -Eq "^($types)(\([a-z0-9][a-z0-9-]*\))?!?: [^ ].*$" \
  || fail "header does not match Conventional Commits: '$header'
Allowed types: ${types}. Scope: lowercase noun in parentheses."

[ ${#header} -le 100 ] || fail "header is ${#header} characters; keep it at 100 or fewer."

[ -z "$line2" ] || fail "leave one blank line between the header and the body."

# BREAKING CHANGE footer must be uppercase (spec rule 15); BREAKING-CHANGE is a synonym (rule 16).
if printf '%s\n' "$msg" | grep -Eiq '^breaking[ -]change:' \
   && ! printf '%s\n' "$msg" | grep -Eq '^BREAKING[ -]CHANGE: [^ ]'; then
  fail "write the footer as 'BREAKING CHANGE: <description>' in uppercase."
fi

exit 0
